class_name Sounds
extends Node
## Everything the game plays (.ai/audio-direction.md): sound effects, pet voices, the music and
## each place's ambience, and the microphone for recording a pet's own sound.
##
## One of these lives on GameRoot for the whole game. It builds its audio buses at start - Music,
## SFX, Voice, Ambience, and a muted Record bus for the mic - so there is no bus layout file, and
## the family's volume settings are applied to them. Call it through the static functions
## (Sounds.play("star")); they do nothing when there is no Sounds node (the art baker, tools).
##
## Every effect is generated by tools/audio/ at the loudness the mix wants and is played at
## unity: balance is changed in tools/audio/sfx.py, not by adding volume at call sites. Every
## button plays a soft tap by itself (node_added), so no screen has to remember to.

## Must match REGISTRY in tools/audio/sfx.py.
const SFX := ["ui_tap", "ui_toggle", "ui_nope", "toast", "star", "buy", "level_up", "trust_up", "adopt",
	"build", "goodbye", "dress", "crayon", "eraser", "fill", "undo", "clear", "dot", "done", "step", "hop",
	"land", "flap", "bubble", "munch", "chew", "sniff", "snore", "heart", "sparkle", "splash", "scratch",
	"throw", "bounce", "squeak", "thud", "catch", "tug", "place", "pickup", "trampoline", "drum", "piano",
	"slide", "shiny", "count_tick", "count_go", "good", "bad", "jump", "drum_beat", "heave", "card_flip",
	"correct", "wrong", "camera", "cheer", "fanfare", "ribbon"]
const LOOPS := ["crayon", "eraser"]
## The longest a kid's own recording may be, in seconds.
const MAX_RECORD := 3.0
## How loud each bus sits under its setting slider, so a "full" music slider is still under the
## effects and the ambience is a bed, not a feature.
const BUS_TRIM := {"Music": -8.0, "SFX": 0.0, "Voice": -1.0, "Ambience": -3.0}

static var main: Sounds

var _streams := {}
var _sfx: Array[AudioStreamPlayer] = []
var _voices: Array[AudioStreamPlayer] = []
var _next_sfx := 0
var _next_voice := 0
var _music: Array[AudioStreamPlayer] = []
var _music_track := ""
var _ambience: Array[AudioStreamPlayer] = []
var _ambience_place := ""
var _loops := {}
var _loop_id := 0
var _mic: AudioStreamPlayer
var _record: AudioEffectRecord


func _ready() -> void:
	main = self
	process_mode = Node.PROCESS_MODE_ALWAYS
	for bus in ["Music", "SFX", "Voice", "Ambience", "Record"]:
		if AudioServer.get_bus_index(bus) == -1:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, bus)
			AudioServer.set_bus_send(i, "Master")
	var sfx_bus := AudioServer.get_bus_index("SFX")
	if AudioServer.get_bus_effect_count(sfx_bus) == 0:
		var limiter := AudioEffectHardLimiter.new()
		limiter.ceiling_db = -1.0
		AudioServer.add_bus_effect(sfx_bus, limiter)
	var rec_bus := AudioServer.get_bus_index("Record")
	AudioServer.set_bus_mute(rec_bus, true)
	if AudioServer.get_bus_effect_count(rec_bus) == 0:
		AudioServer.add_bus_effect(rec_bus, AudioEffectRecord.new())
	_record = AudioServer.get_bus_effect(rec_bus, 0) as AudioEffectRecord

	for id in SFX:
		var path := "res://sfx/%s.wav" % id
		if ResourceLoader.exists(path):
			var s: AudioStreamWAV = load(path)
			if LOOPS.has(id):
				_make_loop(s)
			_streams[id] = s
	# Nobody on this project can hear the game, so say out loud when a sound is missing.
	var missing := SFX.filter(func(id): return not _streams.has(id))
	if not missing.is_empty():
		push_warning("Sounds: %d missing - run python tools/audio/build.py: %s" % [missing.size(), missing])
	print("Sounds: %d effects loaded" % _streams.size())
	for i in 16:
		_sfx.append(_player("SFX"))
	for i in 8:
		_voices.append(_player("Voice"))
	for i in 2:
		_music.append(_player("Music"))
		_ambience.append(_player("Ambience"))
	get_tree().node_added.connect(_on_node_added)


func _player(bus: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	add_child(p)
	return p


## A whole-file loop, whatever the importer decided.
static func _make_loop(s: AudioStreamWAV) -> void:
	s.loop_mode = AudioStreamWAV.LOOP_FORWARD
	s.loop_begin = 0
	s.loop_end = int(s.get_length() * s.mix_rate)


# --- Settings --------------------------------------------------------------------------------

## Applies {music, sfx, voice, ambience} (0..1) to the buses.
func apply_settings(settings: Dictionary) -> void:
	for bus in BUS_TRIM:
		var key: String = bus.to_lower()
		var v := clampf(float(settings.get(key, 1.0)), 0.0, 1.0)
		var i := AudioServer.get_bus_index(bus)
		AudioServer.set_bus_mute(i, v <= 0.001)
		AudioServer.set_bus_volume_db(i, linear_to_db(maxf(v, 0.001)) + float(BUS_TRIM[bus]))


# --- Effects ---------------------------------------------------------------------------------

## Plays an effect. `pitch` also changes its speed; small random wobble is the caller's choice.
static func play(id: String, pitch := 1.0, volume_db := 0.0) -> void:
	if main != null:
		main._play(id, pitch, volume_db)


func _play(id: String, pitch: float, volume_db: float) -> void:
	var s: AudioStream = _streams.get(id)
	if s == null:
		return
	var p := _sfx[_next_sfx]
	_next_sfx = (_next_sfx + 1) % _sfx.size()
	p.stream = s
	p.pitch_scale = clampf(pitch, 0.25, 4.0)
	p.volume_db = volume_db
	p.play()


## Plays an effect a little differently each time, so repeats do not machine-gun.
static func play_varied(id: String, pitch := 1.0, spread := 0.06, volume_db := 0.0) -> void:
	play(id, pitch * (1.0 + randf_range(-spread, spread)), volume_db + randf_range(-1.5, 0.5))


## Plays a stream (a pet's voice, a toy's own sound) on the Voice bus.
static func play_stream(stream: AudioStream, pitch := 1.0, volume_db := 0.0) -> void:
	if main == null or stream == null:
		return
	var p := main._voices[main._next_voice]
	main._next_voice = (main._next_voice + 1) % main._voices.size()
	p.stream = stream
	p.pitch_scale = clampf(pitch, 0.25, 4.0)
	p.volume_db = volume_db
	p.play()


## A looping effect (the crayon scratching): returns a handle for loop_set / loop_stop.
static func loop_start(id: String, volume_db := 0.0) -> int:
	if main == null or not main._streams.has(id):
		return -1
	var p := main._player("SFX")
	p.stream = main._streams[id]
	p.volume_db = volume_db
	p.play()
	main._loop_id += 1
	main._loops[main._loop_id] = p
	return main._loop_id


static func loop_set(handle: int, volume_db: float, pitch := 1.0) -> void:
	if main == null or not main._loops.has(handle):
		return
	var p: AudioStreamPlayer = main._loops[handle]
	p.volume_db = volume_db
	p.pitch_scale = pitch


static func loop_stop(handle: int) -> void:
	if main == null or not main._loops.has(handle):
		return
	var p: AudioStreamPlayer = main._loops[handle]
	main._loops.erase(handle)
	p.queue_free()


# --- Music and ambience ----------------------------------------------------------------------

## Crossfades to a music track ("home", "create", "contest"), or to silence with "".
static func music(track: String) -> void:
	if main != null:
		main._crossfade(main._music, track, "res://music/%s.wav", "_music_track", 1.2)


## Crossfades to a place's ambience loop, or to silence with "".
static func ambience(place: String) -> void:
	if main != null:
		main._crossfade(main._ambience, place, "res://sfx/ambience/%s.wav", "_ambience_place", 1.5)


func _crossfade(pair: Array[AudioStreamPlayer], name: String, pattern: String, field: String,
		secs: float) -> void:
	if get(field) == name:
		return
	set(field, name)
	var old := pair[0]
	var new := pair[1]
	pair.reverse()
	if old.playing:
		var out := create_tween()
		out.tween_property(old, "volume_db", -40.0, secs)
		out.tween_callback(old.stop)
	if name == "":
		return
	var path := pattern % name
	if not ResourceLoader.exists(path):
		return
	var s: AudioStreamWAV = load(path)
	_make_loop(s)
	new.stream = s
	new.volume_db = -40.0
	new.play()
	create_tween().tween_property(new, "volume_db", 0.0, secs)


# --- The microphone --------------------------------------------------------------------------

## Starts recording from the microphone (the Record bus is muted, so it is not played back).
## The caller asks Android for permission first.
static func record_start() -> bool:
	if main == null or main._record == null:
		return false
	if main._mic == null:
		main._mic = AudioStreamPlayer.new()
		main._mic.stream = AudioStreamMicrophone.new()
		main._mic.bus = "Record"
		main.add_child(main._mic)
	main._mic.play()
	main._record.set_recording_active(true)
	return true


## Stops recording and returns what was heard (null if nothing).
static func record_stop() -> AudioStreamWAV:
	if main == null or main._record == null:
		return null
	main._record.set_recording_active(false)
	if main._mic != null:
		main._mic.stop()
	return main._record.get_recording()


# --- Every button taps -----------------------------------------------------------------------

func _on_node_added(node: Node) -> void:
	if node is BaseButton:
		var b := node as BaseButton
		b.pressed.connect(_tap.bind(b))


func _tap(b: BaseButton) -> void:
	if b.has_meta("silent"):
		return
	_play("ui_toggle" if b.toggle_mode else "ui_tap", randf_range(0.96, 1.04), 0.0)
